# Defaults replay data/sample_events into local Delta tables under data/state/delta.
SOURCE=file                 # file | salesforce
SINK=local                  # local | databricks
# EVENTS_PATH=data/sample_events/account_changes.jsonl
# SNAPSHOT_PATH=data/sample_events/snapshot.json
# STATE_DIR=data/state
LOG_LEVEL=INFO

# Loop prevention for write-back (both are checked)
WRITEBACK_CLIENT_ID=sf-dbx-writeback
INTEGRATION_USER_ID=

# Salesforce (SOURCE=salesforce, write-back)
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login
SF_ENTITY=Account
SF_FIELDS=Name,Industry,AnnualRevenue,Rating

# Databricks SQL warehouse (SINK=databricks), Unity Catalog namespace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=salesforce
